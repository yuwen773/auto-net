<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:AutoNet.Tray.Avalonia"
             x:Class="AutoNet.Tray.Avalonia.MainView">
  <Grid ColumnDefinitions="236,*" RowDefinitions="*,Auto">
    <Border Grid.Row="0" Grid.Column="0"
            Background="{DynamicResource ShellNavBackground}"
            BorderBrush="{DynamicResource ShellBorder}"
            BorderThickness="0,0,1,0">
      <DockPanel Margin="0,0,0,8">
        <StackPanel DockPanel.Dock="Top" Margin="20,22,20,16" Spacing="3">
          <TextBlock Text="AutoNet" FontSize="21" FontWeight="SemiBold" />
          <TextBlock Text="校园网连接守护" FontSize="12" Opacity="0.6" />
        </StackPanel>
        <ListBox x:Name="nav" Background="Transparent" BorderThickness="0"
                 SelectionMode="Single" Margin="8,0"
                 AutomationProperties.Name="{x:Static local:ShellAccessibility.NavList}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Row="0" Grid.Column="1">
      <ContentControl x:Name="pageHost" Margin="30,28" VerticalAlignment="Top" HorizontalAlignment="Stretch" />
    </ScrollViewer>
    <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="14,7"
            Background="{DynamicResource ShellStripBackground}"
            BorderBrush="{DynamicResource ShellBorder}"
            BorderThickness="0,1,0,0">
      <TextBlock x:Name="statusText" FontSize="12" Opacity="0.85" TextTrimming="CharacterEllipsis"
                 AutomationProperties.Name="{x:Static local:ShellAccessibility.StatusStrip}" />
    </Border>
  </Grid>
</UserControl>
