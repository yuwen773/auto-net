        "attempts": 0,
        "exhausted": false
      }
    },
    {
      "name": "预留中的一次记录有效",
      "content": "{\"Version\":1,\"State\":\"Reserved\",\"Attempts\":1,\"ReservedAt\":\"2026-01-01T00:00:00+00:00\",\"NextPossibleAt\":\"2026-01-01T00:02:00+00:00\",\"Revision\":\"22222222-2222-2222-2222-222222222222\"}",
      "expect": {
        "outcome": "Valid",
        "state": "Reserved",
        "attempts": 1,
        "reservedAt": 1767225600000,
        "nextPossibleAt": 1767225720000,
        "exhausted": false
      }
    },
    {
      "name": "可能已发出的两次记录有效",
      "content": "{\"Version\":1,\"State\":\"PossiblySent\",\"Attempts\":2,\"ReservedAt\":\"2026-01-01T00:00:00+00:00\",\"NextPossibleAt\":\"2026-01-01T00:02:00+00:00\",\"Revision\":\"22222222-2222-2222-2222-222222222222\"}",
      "expect": {
        "outcome": "Valid",
