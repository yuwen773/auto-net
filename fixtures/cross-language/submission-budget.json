      "name": "Revision 不是 GUID 无效",
      "content": "{\"Version\":1,\"State\":\"Reserved\",\"Attempts\":1,\"ReservedAt\":\"2026-01-01T00:00:00+00:00\",\"NextPossibleAt\":\"2026-01-01T00:02:00+00:00\",\"Revision\":\"not-a-guid\"}",
      "expect": {
        "outcome": "Invalid"
      }
    },
    {
      "name": "Revision 带花括号无效",
      "content": "{\"Version\":1,\"State\":\"Reserved\",\"Attempts\":1,\"ReservedAt\":\"2026-01-01T00:00:00+00:00\",\"NextPossibleAt\":\"2026-01-01T00:02:00+00:00\",\"Revision\":\"{22222222-2222-2222-2222-222222222222}\"}",
      "expect": {
        "outcome": "Invalid"
      }
    },
    {
      "name": "非对象无效",
      "content": "[]",
      "expect": {
        "outcome": "Invalid"
      }
    },
    {
      "name": "破损 JSON 无效",
      "content": "{broken",
      "expect": {
        "outcome": "Invalid"
      }
