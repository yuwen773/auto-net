    {
      "name": "有次数但缺预留时刻无效",
      "content": "{\"Version\":1,\"State\":\"Reserved\",\"Attempts\":1,\"ReservedAt\":\"0001-01-01T00:00:00+00:00\",\"NextPossibleAt\":\"2026-01-01T00:02:00+00:00\",\"Revision\":\"22222222-2222-2222-2222-222222222222\"}",
      "expect": {
        "outcome": "Invalid"
      }
    },
    {
      "name": "间隔不足 120 秒无效",
      "content": "{\"Version\":1,\"State\":\"Reserved\",\"Attempts\":1,\"ReservedAt\":\"2026-01-01T00:00:00+00:00\",\"NextPossibleAt\":\"2026-01-01T00:01:00+00:00\",\"Revision\":\"22222222-2222-2222-2222-222222222222\"}",
      "expect": {
        "outcome": "Invalid"
      }
    },
    {
      "name": "多余字段无效",
      "content": "{\"Version\":1,\"State\":\"Reserved\",\"Attempts\":1,\"ReservedAt\":\"2026-01-01T00:00:00+00:00\",\"NextPossibleAt\":\"2026-01-01T00:02:00+00:00\",\"Revision\":\"22222222-2222-2222-2222-222222222222\",\"Extra\":1}",
      "expect": {
        "outcome": "Invalid"
      }
    },
    {
      "name": "重复字段无效",
      "content": "{\"Version\":1,\"State\":\"Reserved\",\"Attempts\":1,\"ReservedAt\":\"2026-01-01T00:00:00+00:00\",\"NextPossibleAt\":\"2026-01-01T00:02:00+00:00\",\"Revision\":\"22222222-2222-2222-2222-222222222222\",\"Attempts\":1}",
      "expect": {
        "outcome": "Invalid"
