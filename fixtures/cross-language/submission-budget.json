        "reservedAt": 1767225600000,
        "nextPossibleAt": 1767225720000,
        "exhausted": false
      }
    },
    {
      "name": "已结束但保留次数的记录有效",
      "content": "{\"Version\":1,\"State\":\"Concluded\",\"Attempts\":2,\"ReservedAt\":\"2026-01-01T00:00:00+00:00\",\"NextPossibleAt\":\"2026-01-01T00:02:00+00:00\",\"Revision\":\"22222222-2222-2222-2222-222222222222\"}",
      "expect": {
        "outcome": "Valid",
        "state": "Concluded",
        "attempts": 2,
        "reservedAt": 1767225600000,
        "nextPossibleAt": 1767225720000,
        "exhausted": false
      }
    },
    {
      "name": "三次记录有效且视为耗尽",
