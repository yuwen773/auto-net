      "content": "{\"Version\":1,\"State\":\"Reserved\",\"Attempts\":0,\"ReservedAt\":\"0001-01-01T00:00:00+00:00\",\"NextPossibleAt\":\"0001-01-01T00:00:00+00:00\",\"Revision\":\"22222222-2222-2222-2222-222222222222\"}",
